# Passcode gate required before entering the website (server-side only)
APP_PASSCODE=084116

# Random secret used to sign the HttpOnly session cookie (generate a long random string on Vercel)
AUTH_SECRET=set360-change-this-to-a-long-random-secret-in-vercel

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Default Gemini Models (Pro for deep synthesis & chat, Flash for fast news/briefing)
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash
